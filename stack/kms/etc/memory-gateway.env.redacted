# REDACTED COPY of /etc/memory-gateway.env. Values were never copied; the real file stays at that path (mode 600).
# Memory gateway env. Mode 600.
# Extractor primary model: google/gemma-4-31b-it:free
# Base URL is OpenRouter only. No local LLM endpoint.
# Fallback model only if the primary returns HTTP 429: <REDACTED:token-in-comment>:free
# Do not call the fallback unless testing a 429 from the primary.
# Gateway process (src/gateway/config.ts) reads TDAI_LLM_* and TDAI_GATEWAY_*.
# Hermes plugin README reads <REDACTED:token-in-comment> (and MEMORY_TENCENTDB_LLM_* for the provider).
TDAI_LLM_API_KEY=<REDACTED:TDAI_LLM_API_KEY>
TDAI_LLM_BASE_URL=<REDACTED:TDAI_LLM_BASE_URL>
TDAI_LLM_MODEL=<REDACTED:TDAI_LLM_MODEL>
TDAI_GATEWAY_HOST=<REDACTED:TDAI_GATEWAY_HOST>
TDAI_GATEWAY_PORT=<REDACTED:TDAI_GATEWAY_PORT>
TDAI_GATEWAY_API_KEY=<REDACTED:TDAI_GATEWAY_API_KEY>
TDAI_DATA_DIR=<REDACTED:TDAI_DATA_DIR>
MEMORY_TENCENTDB_GATEWAY_HOST=<REDACTED:MEMORY_TENCENTDB_GATEWAY_HOST>
MEMORY_TENCENTDB_GATEWAY_PORT=<REDACTED:MEMORY_TENCENTDB_GATEWAY_PORT>
MEMORY_TENCENTDB_LLM_API_KEY=<REDACTED:MEMORY_TENCENTDB_LLM_API_KEY>
