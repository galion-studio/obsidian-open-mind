# Generated by `galion-boot render-units`. STAGED: not installed, not enabled.
[Unit]
Description=Galion guardian (probes, guardian.db, incidents; records only)
After=network-online.target hermes.service console.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/opt/galion/bin/galion-guardian --config /opt/galion/etc/guardian.toml
Restart=always
RestartSec=5
Nice=10
MemoryMax=64M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=-/opt/galion/galion-light/state -/opt/galion/galion-light/guardian -/opt/galion/hermes/activity.jsonl -/opt/galion/hermes/last-guardian.ts
