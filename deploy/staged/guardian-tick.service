# Generated by `galion-boot render-units`. STAGED: not installed, not enabled.
[Unit]
Description=Galion guardian tick (report only; probes from deploy/survival/probes.toml)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/galion/bin/guardian-tick --probes /opt/galion/etc/probes.toml --out /opt/galion/galion-light/state/guardian-tick.json
Nice=10
MemoryMax=64M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=-/opt/galion/galion-light/state
