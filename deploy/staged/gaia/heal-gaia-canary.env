# STAGED example instance: /etc/galion/gaia/heal-gaia-canary.env for
# gaia-heal-tick@gaia-canary. The canary is gaia-dummy, a test service that serves
# GET /health on 127.0.0.1:19880 (free on the VPS at 2026-10-21 13:27 +02:00).
# Gaia can only heal 127.0.0.1:19000-19999 test services; live units are refused.
GAIA_PORT=19880
GAIA_ALLOW_PORTS=19880-19880
GAIA_HEALTH=/health
# Split on spaces by systemd ($GAIA_START_ARGV, unbraced). Absolute path, no shell.
GAIA_START_ARGV=/opt/galion/rust/bin/gaia-dummy --port 19880
