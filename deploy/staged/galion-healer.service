# Generated by `galion-boot render-units`. STAGED: not installed, not enabled.
[Unit]
Description=Galion desk healer (cases, follow-ups; allow-listed repairs, dry-run)
After=network-online.target hermes.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/opt/galion/bin/galion-healer run --config /opt/galion/etc/healer.toml
Restart=always
RestartSec=5
Nice=10
MemoryMax=64M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=-/opt/galion/galion-light/state
