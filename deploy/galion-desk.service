[Unit]
Description=Galion desk (Rust port of /opt/galion/bin/galion-desk)
After=network.target

[Service]
Type=simple
ExecStart=/opt/galion/rust/bin/galion-desk
Environment=DESK_BIND=127.0.0.1:8646
Environment=DESK_HERMES_BIN=/opt/galion/rust/bin/desk-hermes
Restart=on-failure
RestartSec=2

# No [Install] section on purpose: this unit must not be enabled until Slavik
# approves the switch. The live galion-desk.service still carries [Install]
# WantedBy=multi-user.target; this staged copy drops it so it cannot be enabled.
