# S4.7 step 1: report-only (no heal subcommand, no --allow). Rollback: systemctl disable --now guardian-tick.timer
[Unit]
Description=Galion guardian tick (report only; probes from /opt/galion/etc/probes.toml)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/galion/rust/bin/guardian-tick --probes /opt/galion/etc/probes.toml --out /opt/galion/galion-light/state/guardian-tick.json
Nice=10
MemoryMax=64M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=-/opt/galion/galion-light/state
