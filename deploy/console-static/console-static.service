#
# STAGED PROPOSAL ONLY (B61, swarm/console-static). Not installed, not enabled.
# Installing it needs Slavik's approval and the cutover steps in
# docs/console-static.md. It takes over 127.0.0.1:8080 (the cloudflared
# origin) from the Vite dev server, which first moves to 127.0.0.1:8088
# (see console-upstream-8088.conf). No Node runs in this unit.
[Unit]
Description=Galion console static front (Rust, B61)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/galion/bin/galion-console-static \
  --bind 127.0.0.1:8080 \
  --root /opt/galion/console-static/current/client \
  --routes /opt/galion/console-static/current/routes.txt \
  --upstream 127.0.0.1:8088 \
  --proxy-prefix /api/ \
  --proxy-prefix /_serverFn/
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
RestrictAddressFamilies=AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
ReadOnlyPaths=/opt/galion/console-static
InaccessiblePaths=-/opt/galion/galion-light/secrets -/root
MemoryMax=64M
TasksMax=512
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
