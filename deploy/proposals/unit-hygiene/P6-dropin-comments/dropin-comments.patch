--- a/etc/systemd/system/galion-nerve.service.d/60-nerve-eventlog.conf
+++ b/etc/systemd/system/galion-nerve.service.d/60-nerve-eventlog.conf
@@ -1,7 +1,9 @@
 # 2026-10-21 slot 180 (Mate t184 D2, owner Slavik t175): enable the JSONL event log
 # behind POST /event + GET /events. Rotation 8 MiB x 3 kept (max 32 MiB).
-# NOTE: the galion-nerve binary live on 2026-10-21 (2f5a730 build) ignores this
-# variable; it takes effect when the binary is replaced by openmind-nerve (cutover).
+# ACTIVE since 2026-10-21 09:43:54 +02:00: 50-rust-bin.conf runs openmind-nerve-aa77864,
+# which reads this variable (GET /events 200, checked 2026-10-21 11:26 +02:00).
+# The old /opt/galion/rust/bin/galion-nerve (2f5a730 build) ignores it: if 50-rust-bin.conf
+# is rolled back, this file becomes inert again (harmless).
 # Rollback: rm this file; systemctl daemon-reload; systemctl restart galion-nerve
 [Service]
 Environment=NERVE_EVENT_LOG=/var/lib/galion-nerve/events.jsonl
--- a/etc/systemd/system/hermes-rs.service.d/60-nerve-url.conf
