# Generated by `galion-boot render-units`. STAGED: not installed, not enabled.
[Unit]
Description=Galion hardware probe (writes hardware.json, machine.json)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/galion/bin/galion-boot hardware --state-dir /opt/galion/galion-light/state
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=-/opt/galion/galion-light/state
