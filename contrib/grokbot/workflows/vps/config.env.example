# Slavik's VPS — connection settings used by every script in ~/workflows/vps/bin
# ---------------------------------------------------------------------------
# FILL IN THESE TWO VALUES (then run: ~/workflows/vps/bin/set-target.sh to sync ~/.ssh/config,
# or simply run: ~/workflows/vps/bin/set-target.sh <host-or-ip> <user> to set both at once).
VPS_HOST=__FILL_ME_HOST__
VPS_USER=__FILL_ME_USER__

# Optional (defaults are fine)
VPS_PORT="22"
VPS_ALIAS="my-vps"                           # Host entry in ~/.ssh/config
VPS_KEY="$HOME/.ssh/id_ed25519"              # path to your existing SSH private key (never commit the key)
VPS_CONNECT_TIMEOUT="10"

# Local output (findings, logs, change records). Nothing is written on the VPS by read-only scripts.
VPS_DATA_DIR="$HOME/workflows/vps/data"
VPS_STACK_MAP="$HOME/workflows/vps/stack-map.md"
VPS_SERVICES_LIST="$HOME/workflows/vps/services.list"

# Remote backup location used ONLY by mutating scripts (deploy.sh --apply, service-action.sh --apply)
VPS_REMOTE_BACKUP_DIR="~/vps-backups"

# Alerting for routine checks (optional). Command receives the alert summary on stdin.
# Leave empty to only write alerts to $VPS_DATA_DIR/health/ALERT-*.txt
VPS_ALERT_CMD=""
