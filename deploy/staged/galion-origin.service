# Generated by `galion-boot render-units`. STAGED: not installed, not enabled.
[Unit]
Description=Galion origin (grinder page, desk notes, splash; loopback)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/opt/galion/bin/galion-origin
Environment=ORIGIN_ADDR=127.0.0.1:8655
Environment=ORIGIN_ROOT=/opt/galion/galion-light
Environment=ORIGIN_GRINDER_ROOT=/var/www/grinder
Restart=always
RestartSec=5
MemoryMax=32M
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
