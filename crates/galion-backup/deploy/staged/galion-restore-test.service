# STAGED (wave-4 slot 326, 2026-10-28 CET +01:00): NOT INSTALLED.
# Daily restore test of the newest backup with the Rust `galion-backup
# restore-test` (port of /opt/galion/rust/bin/galion-restore-test.sh, which
# had no unit or timer: it only ran by hand). Restores into a private /tmp,
# verifies SHA256SUMS + every DB's integrity_check + the presence list, then
# removes everything; exit 1 on any failure (the .sh exited 0 after a
# checksum FAILED, finding F-326-1). Install only with D-326-1 in
# docs/galion-backup-fold.md (binary galion-backup-2595481 first; owner go).
# Rollback: systemctl disable --now galion-restore-test.timer; remove both files.
[Unit]
Description=Galion restore test: newest backup restored to a temp dir and verified (Rust)
After=galion-backup.service
ConditionPathIsDirectory=/var/backups/galion

[Service]
Type=oneshot
ExecStart=/opt/galion/rust/bin/galion-backup-2595481 restore-test
Nice=19
IOSchedulingClass=idle
UMask=0077
TimeoutStartSec=15min
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
