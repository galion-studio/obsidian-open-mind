# galion-accounts environment: /etc/galion/accounts.env, owner root:root, mode 0600.
# Template only: every value is empty or a public default. Empty = that payment method is OFF.
# systemd EnvironmentFile syntax: KEY=VALUE, no shell, no `export`, quotes optional.
# Check without showing values:  galion-accounts readiness --env-file /etc/galion/accounts.env ...
# See SWITCH-ON.md. Never paste a value from this file into chat, tickets or git.

# --- Site -------------------------------------------------------------------
ACCOUNTS_TRUST_PROXY=1
ACCOUNTS_PUBLIC_URL=https://galion.app
#ACCOUNTS_COOKIE_DOMAIN=.galion.app

# --- Tokens for the internal port 127.0.0.1:19971 (generate ON the server) ---
# 64 hex chars each; empty = the internal API refuses everything (fail closed).
# INTERNAL: entitlement lookups by other Galion services.
# ADMIN: cash credit, cash lookup, admin status, crypto poll.
ACCOUNTS_INTERNAL_TOKEN=
ACCOUNTS_ADMIN_TOKEN=

# --- Card: Stripe (main method) ----------------------------------------------
# Slavik pastes these himself on the server. sk_live_... or a restricted rk_live_...
STRIPE_SECRET_KEY=
# whsec_... written by `stripe-setup --apply ... --secret-out FILE` (never printed).
STRIPE_WEBHOOK_SECRET=
# bpc_... printed by `stripe-setup --apply` (cancel at period end, Plus<->Pro, card update).
STRIPE_PORTAL_CONFIG=
# Optional: price ids. Empty = look up galion_plus_monthly / galion_pro_monthly.
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
# 1 = Stripe Tax in Checkout (needs Stripe Tax set up in the Dashboard first).
STRIPE_AUTOMATIC_TAX=
# Webhook signature age limit in seconds (default 300).
#STRIPE_WEBHOOK_TOLERANCE_SECS=300

# --- Cash in an envelope -----------------------------------------------------
# Postal address, lines separated by |   Empty = cash is off.
ACCOUNTS_CASH_ADDRESS=

# --- Crypto (self-hosted, both optional) ------------------------------------
# Comma list: btcpay, monero. Empty = crypto is off and the button is hidden.
ACCOUNTS_CRYPTO_BACKENDS=

# BTCPay Server Greenfield (BTC). All four needed for btcpay.
BTCPAY_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=
#BTCPAY_INVOICE_MINUTES=60

# monero-wallet-rpc (XMR), ideally a view-only wallet bound to localhost.
MONERO_WALLET_RPC_URL=
# user:pass, the same as monero-wallet-rpc --rpc-login
MONERO_WALLET_RPC_LOGIN=
# Rate: either a fixed EUR per XMR, or btcpay (uses the BTCPay store's XMR_EUR rate).
MONERO_EUR_RATE=
MONERO_RATE_SOURCE=
#MONERO_CONFIRMATIONS=10
#MONERO_ADDRESS_MODE=subaddress
#MONERO_ACCOUNT_INDEX=0
#MONERO_INVOICE_MINUTES=60
#MONERO_POLL_SECONDS=60
