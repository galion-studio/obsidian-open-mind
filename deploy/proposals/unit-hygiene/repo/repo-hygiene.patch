 # SPDX-License-Identifier: MIT
 # SPDX-FileCopyrightText: 3000 Galion / galion-studio
 #
-# STAGED, NOT INSTALLED. Awaiting Slavik's approval (docs/ws-one-desk-tuner.md).
-# Replaces the nohup-started ./one/one (pid since 2026-10-13, cwd
-# /opt/galion/galion-light, log /var/log/galion-one.log) with the openmind
-# crates/galion-one build. No [Install] section on purpose: it cannot be
-# enabled by accident; the switch steps add the boot hook explicitly.
+# INSTALLED and ENABLED on the VPS since 2026-10-18 22:13 +02:00 (link in
+# multi-user.target.wants). Replaced the nohup-started ./one/one (cwd
+# /opt/galion/galion-light, log /var/log/galion-one.log).
+# The binary that runs is set by the drop-in galion-one.service.d/50-rust-bin.conf
+# (since 2026-10-21 08:39 +02:00: /opt/galion/rust/bin/galion-one, swarm/one-no-shellout 40454f9).
+# The ExecStart below is the older build inside the frozen working copy. It is kept
+# on purpose: removing 50-rust-bin.conf is the rollback.
+# Hygiene proposal deploy/proposals/unit-hygiene P1 (slot 183, 2026-10-21 +02:00).
 [Unit]
 Description=Galion One (Rust, openmind crates/galion-one): text 127.0.0.1:8091, mouth 127.0.0.1:8002
-After=network-online.target hermes.service
+After=network-online.target hermes-rs.service
 Wants=network-online.target
 StartLimitIntervalSec=300
 StartLimitBurst=10
@@ -18,8 +21,8 @@ Type=simple
 WorkingDirectory=/opt/galion/galion-light
 ExecStart=/opt/galion/openmind/dist/bin-ws/galion-one
 # Every value below is the live default, written out so a typo cannot
-# silently change behaviour. A missing ONE_DEVICE_STORE file means "unpaired"
-# and leaves One OPEN (castle() is false), exactly like the live binary.
+# silently change behaviour. A missing or empty ONE_DEVICE_STORE file means
+# "nobody paired": One fails CLOSED (every gated route answers 401 pair).
 Environment=GALION_HOME=/workspace/galion-light
 Environment=ONE_BIND=127.0.0.1:8091
 Environment=ONE_MOUTH_BIND=127.0.0.1:8002
@@ -40,3 +43,6 @@ NoNewPrivileges=true
 ProtectSystem=full
 MemoryMax=128M
 TasksMax=512
+
+[Install]
+WantedBy=multi-user.target
