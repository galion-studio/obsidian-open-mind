# S4.7 step 1: report-only timer. Enable only after a successful one-shot dry run.
[Unit]
Description=Galion guardian tick (report only) every 60s

[Timer]
OnBootSec=30s
OnUnitActiveSec=60s
AccuracySec=5s
Unit=guardian-tick.service
Persistent=false

[Install]
WantedBy=timers.target
