<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- ~/Library/LaunchAgents/com.galion.offsite-pull.plist (ws/offsite). __HOME__ is replaced by install-laptop.sh.
     Runs at :45 past the VPS backup hours (local time; missed runs fire on wake).
     Manual: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.galion.offsite-pull.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.galion.offsite-pull</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>__HOME__/.galion-offsite/galion-offsite-pull.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/galion-offsite-pull.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/galion-offsite-pull.log</string>
</dict>
</plist>
